    ["proc", "dv = |dv1| + |dv2|", 150],
    ["proc2", "razao = e^(dv x 1000 / (Isp x 9.81))", 230],
    ["proc", "combustivel = m x (razao - 1)", 200],
    ["proc", "toneladas = combustivel / 1000", 200],
    ["display", "dias", 150],
