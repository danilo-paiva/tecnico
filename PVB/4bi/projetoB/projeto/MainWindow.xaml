<Window x:Class="projetoB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avaliacao de IMC - Fisioterapia (B)"
        Width="1100" Height="720" FontSize="20"
        WindowStartupLocation="CenterScreen">

    <!-- Layout B: formulario e acoes na coluna esquerda; lista e
         relatorio na direita. Fonte 20 herdada do Window. -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Coluna esquerda: dados e botoes -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <Label Content="Dados do paciente"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Id"/>
                <TextBox Grid.Column="1" x:Name="txtIdentificador" Margin="0,3,0,3"/>

                <Label Grid.Row="1" Content="Nome"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPaciente" Margin="0,3,0,3"/>

                <Label Grid.Row="2" Content="Peso (Kg)"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtQuilos" Margin="0,3,0,3"/>

                <Label Grid.Row="3" Content="Altura (m)"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtEstatura" Margin="0,3,0,3"/>
            </Grid>

            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button Content="Cadastrar" Margin="3" Click="Cadastrar_Click"
                        Background="#0F6CBD" Foreground="White" BorderBrush="#0B5897"
                        FontWeight="SemiBold"/>
                <Button Content="Consultar" Margin="3" Click="Consultar_Click"/>
                <Button Content="Alterar" Margin="3" Click="Alterar_Click"/>
                <Button Content="Excluir" Margin="3" Click="Excluir_Click"/>
            </UniformGrid>

            <Label Content="Relatorios" Margin="0,12,0,0"/>

            <Button Content="Relatorio (texto)" Margin="0,3,0,0" Click="Relatorio_Click"/>
            <Button Content="Grafico HTML" Margin="0,3,0,0" Click="Grafico_Click"/>
            <Button Content="Dados HTML" Margin="0,3,0,0" Click="Dados_Click"
                    Background="#0F6CBD" Foreground="White" BorderBrush="#0B5897"/>

            <Label x:Name="lblMensagem" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Coluna direita: lista e relatorio -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <Label Content="Pacientes cadastrados"/>
                <ListBox x:Name="lstAvaliados"
                         SelectionChanged="lstAvaliados_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Label Content="Relatorio"/>
                <TextBox x:Name="txtResumo" Height="200"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
