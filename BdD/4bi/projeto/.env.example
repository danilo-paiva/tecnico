# Modelo de configuração — copie para .env e preencha com a sua URI.
#
# O arquivo .env (com a senha de verdade) NÃO vai para o Git:
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
#
# MongoDB local (Community Server):
MONGO_URI=mongodb://localhost:27017/

# MongoDB Atlas (troque usuario, senha e cluster):
# MONGO_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/
#
# Se a senha tiver caracteres especiais, codifique na URI:
#   @ -> %40    # -> %23    : -> %3A    / -> %2F    ? -> %3F
