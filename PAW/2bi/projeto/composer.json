{
    "name": "aluno/gestao-eventos",
    "description": "REST API de gestao de eventos e ingressos (Slim 4, MVC + DAO)",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Api\\": "src/api/"
        }
    },
    "require": {
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1"
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
