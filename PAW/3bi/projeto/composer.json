{
    "name": "aluno/gestao-eventos",
    "description": "REST API de gestao de eventos e ingressos (Slim 4, MVC + DAO) com JWT e frontend HTML/JS — 3o bimestre de PAW",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Api\\": "src/api/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
